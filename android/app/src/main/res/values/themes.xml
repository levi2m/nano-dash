<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light: the window background matches the app's page colour so there is no flash at launch. -->
    <style name="Theme.NanoDash" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/nano_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
